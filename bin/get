[[ -z "$1" ]] && usage

thing=
args=()

while [[ -z "$thing" ]]; do
    case "$1" in
        -h|--help)          usage;;
        -l|--list-things)   list_all_things;;
        -L|--list-options)  list_all_options;;
        -*)                 usage "Unrecognized option: ${1}";;
        *)                  thing="${1}";;
    esac
    shift
done

while [[ -n "$1" ]]; do
    args+=("$1")
    shift
done

# echo "$thing"
# echo "${args[@]}"

"get_${thing}" "${args[@]}"
