#!/usr/bin/env bash

if [[ -z "$1" ]]; then
    echo "usage: $(basename $0) <input-to-sefaria-command>"
    exit 1
fi

heb="$(book-hebrew $@ -l he)"

book_and_chapter="$(echo "$heb" | head -1 | cut -f1 -d:)"

read book chapter <<< "$book_and_chapter"

# lowercase the book
b="$(tr A-Z a-z <<< "$book")"

# pad the chapter
c="$(printf "%02d\n" "$chapter")"

eng="$(cat eng/*-${b}/${c}*.md)"

# tex="$(cat *-${b}/${c}*.tex)"

output="$(cat << EOF

#################
### Your Task ###
#################

Read the text below, and turn the separate
english and hebrew text into a combined LuaLaTeX
file of the form given below, with attributions
to the J, E, P, R, D, etc sources using the provided
source map.


########################################################
### Hebrew Text to Use for Generating the Latex File ###
########################################################

${heb}


#########################################################
### English Text to Use for Generating the Latex File ###
#########################################################

${eng}


########################################################
### Source map I want you to use for the attribution ###
### of sources like J, E, P, R, D, etc to the verses ###
### according to the Documentary Hypothesis.         ###
########################################################

$(book-source-map)


###################################################
### Format of the LaTeX project that I want you ###
### to generate a new file for, containing both ###
### english and hebrew text above               ###
###################################################

$(make c)


###############
### Summary ###
###############

Using the above english and hebrew text, generate a
new LuaLaTeX file to match the format of the LuaLaTeX
example file you just read.

EOF
)"

echo "$output"
[ -t 1 ] && {
    echo "$output" | xc
}
