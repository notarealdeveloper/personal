#!/usr/bin/env python3
import argparse
import json
import re
import sys
import textwrap
import unicodedata
from pathlib import Path

HASH_RULE_RE = re.compile(r"^#{3,}\s*$")
HASH_TITLE_RE = re.compile(r"^#{3,}\s*(.*?)\s*#{3,}\s*$")

HEBREW_LINE_RE = re.compile(
    r"^(?P<book>[1-3]?\s?[A-Za-z]+)\s+"
    r"(?P<chapter>\d+):(?P<verse>\d+)\s+"
    r"(?P<text>.*)$"
)

ENGLISH_HEADER_RE = re.compile(
    r"^##\s+(?P<book>[1-3]?\s?[A-Za-z]+)\s+"
    r"(?P<chapter>\d+):(?P<verse>\d+)\s*$"
)

SOURCE_RANGE_RE = re.compile(
    r"^(?P<book>[1-3]?\s?[A-Za-z]+)\s+"
    r"(?P<c1>\d+)"
    r"(?::(?P<v1>\d+))?"
    r"(?:[–-](?:(?P<c2>\d+):)?(?P<v2>\d+[a-z]?))?$"
)

SUPERSCRIPTS = str.maketrans({
    "⁰": "", "¹": "", "²": "", "³": "", "⁴": "",
    "⁵": "", "⁶": "", "⁷": "", "⁸": "", "⁹": "",
})

SOURCE_MACRO = {
    "J": "J",
    "E": "E",
    "P": "P",
    "R": "R",
    "RJE": "RJE",
    "Other": "Other",
    "O": "Other",
    "BR": "BookOfRecords",
    "Records": "BookOfRecords",
}


def die(msg: str) -> None:
    print(f"{Path(sys.argv[0]).name}: {msg}", file=sys.stderr)
    raise SystemExit(1)


def is_title_line(line: str) -> bool:
    m = HASH_TITLE_RE.match(line.strip())
    return bool(m and m.group(1).strip())


def title_text(line: str) -> str:
    m = HASH_TITLE_RE.match(line.strip())
    return m.group(1).strip() if m else ""


def find_section(prompt: str, needle: str) -> str:
    """
    Finds banner sections like:

        #######
        ### Title line 1 ###
        ### Title line 2 ###
        #######

    Returns the content after the closing hash rule, stopping before
    the next banner.
    """
    lines = prompt.splitlines()
    needle = needle.lower()

    start_rule = None
    close_rule = None

    i = 0
    while i < len(lines):
        if not HASH_RULE_RE.match(lines[i].strip()):
            i += 1
            continue

        j = i + 1
        title_lines = []
        while j < len(lines) and is_title_line(lines[j]):
            title_lines.append(title_text(lines[j]))
            j += 1

        if title_lines and j < len(lines) and HASH_RULE_RE.match(lines[j].strip()):
            combined = " ".join(title_lines).lower()
            if needle in combined:
                start_rule = i
                close_rule = j
                break
            i = j + 1
        else:
            i += 1

    if start_rule is None or close_rule is None:
        die(f"could not find section containing: {needle!r}")

    start = close_rule + 1
    while start < len(lines) and not lines[start].strip():
        start += 1

    end = start
    while end < len(lines):
        if HASH_RULE_RE.match(lines[end].strip()):
            j = end + 1
            found_title = False
            while j < len(lines) and is_title_line(lines[j]):
                found_title = True
                j += 1
            if found_title and j < len(lines) and HASH_RULE_RE.match(lines[j].strip()):
                break
        end += 1

    return "\n".join(lines[start:end]).strip()


def clean_hebrew(s: str) -> str:
    s = unicodedata.normalize("NFC", s)
    s = s.replace("\u00a0", " ")
    s = s.replace("\u2009", " ")
    s = s.replace("־", " ")   # Hebrew maqaf
    s = s.replace("`", " ")   # stray backticks, if any
    s = re.sub(r"\s*\{[פס]\}\s*$", "", s)
    s = re.sub(r"\s+", " ", s).strip()
    return s


def parse_hebrew(block: str) -> tuple[str, int, dict[int, str]]:
    book = None
    chapter = None
    verses: dict[int, str] = {}

    for raw in block.splitlines():
        line = raw.strip()
        if not line:
            continue

        m = HEBREW_LINE_RE.match(line)
        if not m:
            continue

        book = m.group("book")
        chapter = int(m.group("chapter"))
        verse = int(m.group("verse"))
        verses[verse] = clean_hebrew(m.group("text"))

    if book is None or chapter is None or not verses:
        die("could not parse Hebrew verses")

    return book, chapter, verses


def parse_english(block: str) -> dict[int, tuple[str, str]]:
    verses: dict[int, tuple[str, str]] = {}
    lines = block.splitlines()
    i = 0

    while i < len(lines):
        m = ENGLISH_HEADER_RE.match(lines[i].strip())
        if not m:
            i += 1
            continue

        verse = int(m.group("verse"))
        i += 1
        buf = []

        while i < len(lines) and not ENGLISH_HEADER_RE.match(lines[i].strip()):
            buf.append(lines[i])
            i += 1

        verses[verse] = split_english_body("\n".join(buf), verse)

    if not verses:
        die("could not parse English verses")

    return verses


def split_english_body(body: str, verse: int) -> tuple[str, str]:
    body = body.strip()

    # Drop long markdown separator lines.
    body = re.sub(r"(?m)^-{5,}\s*$", "", body).strip()

    footnote = ""
    parts = re.split(r"(?m)^---+\s*$", body, maxsplit=1)
    if len(parts) == 2:
        body, footnote = parts[0].strip(), parts[1].strip()

    lines = []
    for ln in body.splitlines():
        s = ln.strip()
        if not s:
            continue
        if s == str(verse):
            continue
        lines.append(s)

    main = " ".join(lines).translate(SUPERSCRIPTS).strip()
    main = re.sub(r"\s+", " ", main)

    footnote = footnote.strip()
    footnote = re.sub(rf"^Footnote\s+\d+:{verse}\.\s*", "", footnote, flags=re.I | re.S)
    footnote = re.sub(r"\s+", " ", footnote).strip()

    return main, footnote


def parse_source_map(block: str) -> dict[str, str]:
    start = block.find("{")
    end = block.rfind("}")
    if start < 0 or end < start:
        die("could not find JSON object in source map section")
    return json.loads(block[start:end + 1])


def verse_num(s: str | None, default: int) -> int:
    if not s:
        return default
    m = re.match(r"(\d+)", s)
    if not m:
        return default
    return int(m.group(1))


def parse_source_key(key: str):
    m = SOURCE_RANGE_RE.match(key.strip())
    if not m:
        return None

    book = m.group("book")
    c1 = int(m.group("c1"))
    v1 = verse_num(m.group("v1"), 1)

    c2 = int(m.group("c2") or c1)
    v2 = verse_num(m.group("v2"), v1 if m.group("v1") else 999)

    return book, c1, v1, c2, v2


def normalize_book(book: str) -> str:
    aliases = {
        "genesis": "gen",
        "gen": "gen",
        "exodus": "exod",
        "exod": "exod",
        "leviticus": "lev",
        "lev": "lev",
        "numbers": "num",
        "num": "num",
        "deuteronomy": "deut",
        "deut": "deut",
        "joshua": "josh",
        "josh": "josh",
        "judges": "judg",
        "judg": "judg",
    }
    key = book.lower().replace(" ", "")
    return aliases.get(key, key)


def normalize_source(src: str) -> str:
    first = src.split(",")[0].strip()
    return SOURCE_MACRO.get(first, first)


def source_for(book: str, chapter: int, verse: int, source_map: dict[str, str]) -> str:
    want_book = normalize_book(book)
    here = (chapter, verse)

    for key, src in source_map.items():
        parsed = parse_source_key(key)
        if not parsed:
            continue

        b, c1, v1, c2, v2 = parsed
        if normalize_book(b) != want_book:
            continue

        if (c1, v1) <= here <= (c2, v2):
            return normalize_source(src)

    return "Other"


def tex_escape(s: str) -> str:
    repl = {
        "\\": r"\textbackslash{}",
        "&": r"\&",
        "%": r"\%",
        "$": r"\$",
        "#": r"\#",
        "_": r"\_",
        "{": r"\{",
        "}": r"\}",
        "~": r"\textasciitilde{}",
        "^": r"\textasciicircum{}",
    }
    return "".join(repl.get(ch, ch) for ch in s)


def wrap_english(s: str, width: int = 58) -> list[str]:
    if not s:
        return []
    return textwrap.wrap(
        tex_escape(s),
        width=width,
        break_long_words=False,
        break_on_hyphens=False,
    )


def hebrew_block(source: str, text: str) -> str:
    return f"\t\\h{source}{{{text}}}"


def english_block(source: str, text: str) -> str:
    lines = wrap_english(text)
    if not lines:
        return f"\t\\e{source}{{}}"
    if len(lines) == 1:
        return f"\t\\e{source}{{{lines[0]}}}"

    joined = "\\\\\n\t\t".join(lines) + r"\\"
    return f"\t\\e{source}{{\n\t\t{joined}\n\t}}"


def emit_tex(
    book: str,
    chapter: int,
    hebrew: dict[int, str],
    english: dict[int, tuple[str, str]],
    source_map: dict[str, str],
) -> str:
    chunks: list[str] = [
        "%%%%%%%%%%%%%%%%",
        f"%%% {normalize_book(book)} {chapter} %%%",
        "%%%%%%%%%%%%%%%%",
        "",
        f"\\Chapter{{{chapter}}}",
        "",
    ]

    for verse in sorted(hebrew):
        source = source_for(book, chapter, verse, source_map)
        eng, foot = english.get(verse, ("", ""))

        chunks.extend([
            f"\\Verse{{{verse}}}",
            "{",
            hebrew_block(source, hebrew[verse]),
            "}",
            "{",
            english_block(source, eng),
            "}",
            "{",
        ])

        if foot:
            chunks.append("%\t\\footnote{")
            for line in wrap_english(foot, width=72):
                chunks.append(f"%\t\t{line}")
            chunks.append("%\t}")

        chunks.extend(["}", ""])

    return "\n".join(chunks).rstrip() + "\n"


def main() -> None:
    ap = argparse.ArgumentParser()
    ap.add_argument("prompt", nargs="?")
    ap.add_argument("-o", "--output")
    args = ap.parse_args()

    if args.prompt:
        prompt = Path(args.prompt).read_text(encoding="utf-8")
    else:
        prompt = sys.stdin.read()

    heb_block = find_section(prompt, "Hebrew Text")
    eng_block = find_section(prompt, "English Text")
    map_block = find_section(prompt, "Source map")

    book, chapter, hebrew = parse_hebrew(heb_block)
    english = parse_english(eng_block)
    source_map = parse_source_map(map_block)

    out = emit_tex(book, chapter, hebrew, english, source_map)

    if args.output:
        Path(args.output).write_text(out, encoding="utf-8")
    else:
        sys.stdout.write(out)


if __name__ == "__main__":
    main()
