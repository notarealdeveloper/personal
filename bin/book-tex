#!/usr/bin/env python3
import argparse
import json
import re
import sys
import textwrap
import unicodedata
from pathlib import Path

SECTION_RE = re.compile(r"^#{3,}\s*(.*?)\s*#{3,}\s*$", re.M)

HEBREW_LINE_RE = re.compile(
    r"^(?P<book>[1-3]?\s?[A-Za-z]+)\s+"
    r"(?P<chapter>\d+):(?P<verse>\d+)\s+"
    r"(?P<text>.*)$"
)

ENGLISH_HEADER_RE = re.compile(
    r"^##\s+(?P<book>[1-3]?\s?[A-Za-z]+)\s+"
    r"(?P<chapter>\d+):(?P<verse>\d+)\s*$"
)

SOURCE_RANGE_RE = re.compile(
    r"^(?P<book>[1-3]?\s?[A-Za-z]+)\s+"
    r"(?P<c1>\d+)"
    r"(?::(?P<v1>\d+))?"
    r"(?:[–-](?:(?P<c2>\d+):)?(?P<v2>\d+))?$"
)

SUPERSCRIPTS = str.maketrans({
    "⁰": "", "¹": "", "²": "", "³": "", "⁴": "",
    "⁵": "", "⁶": "", "⁷": "", "⁸": "", "⁹": "",
})

SOURCE_MACRO = {
    "J": "J",
    "E": "E",
    "P": "P",
    "R": "R",
    "RJE": "RJE",
    "Other": "Other",
    "O": "Other",
    "BR": "BookOfRecords",
    "Records": "BookOfRecords",
}


def die(msg: str) -> None:
    print(f"{Path(sys.argv[0]).name}: {msg}", file=sys.stderr)
    raise SystemExit(1)


def section_after(prompt: str, title_part: str) -> str:
    matches = list(SECTION_RE.finditer(prompt))
    for i, m in enumerate(matches):
        if title_part.lower() in m.group(1).lower():
            start = m.end()
            end = matches[i + 1].start() if i + 1 < len(matches) else len(prompt)
            return prompt[start:end].strip()
    die(f"could not find section containing: {title_part!r}")


def parse_hebrew(block: str) -> tuple[str, int, dict[int, str]]:
    verses = {}
    book = None
    chapter = None

    for raw in block.splitlines():
        line = raw.strip()
        if not line:
            continue

        m = HEBREW_LINE_RE.match(line)
        if not m:
            continue

        book = m.group("book")
        chapter = int(m.group("chapter"))
        verse = int(m.group("verse"))
        text = clean_hebrew(m.group("text"))
        verses[verse] = text

    if book is None or chapter is None or not verses:
        die("could not parse Hebrew verses")

    return book, chapter, verses


def parse_english(block: str) -> dict[int, tuple[str, str]]:
    """
    Returns:
      verse -> (main_text, footnote_text)
    """
    lines = block.splitlines()
    out = {}
    i = 0

    while i < len(lines):
        m = ENGLISH_HEADER_RE.match(lines[i].strip())
        if not m:
            i += 1
            continue

        verse = int(m.group("verse"))
        i += 1
        buf = []

        while i < len(lines) and not ENGLISH_HEADER_RE.match(lines[i].strip()):
            buf.append(lines[i])
            i += 1

        main, foot = split_english_body("\n".join(buf), verse)
        out[verse] = (main, foot)

    if not out:
        die("could not parse English verses")

    return out


def split_english_body(body: str, verse: int) -> tuple[str, str]:
    body = body.strip()
    body = re.sub(r"^-{5,}\s*$", "", body, flags=re.M).strip()

    footnote = ""
    parts = re.split(r"(?m)^---+\s*$", body, maxsplit=1)
    if len(parts) == 2:
        body, footnote = parts[0].strip(), parts[1].strip()

    # Remove stray chapter number line and leading verse superscript.
    lines = [ln.rstrip() for ln in body.splitlines()]
    lines = [ln for ln in lines if ln.strip() and ln.strip() != str(verse)]
    body = " ".join(ln.strip() for ln in lines).strip()
    body = body.translate(SUPERSCRIPTS).strip()

    footnote = re.sub(rf"^Footnote\s+\d+:{verse}\.\s*", "", footnote.strip(), flags=re.I | re.S)
    footnote = re.sub(r"\s+", " ", footnote).strip()

    return body, footnote


def clean_hebrew(s: str) -> str:
    s = unicodedata.normalize("NFC", s)
    s = re.sub(r"\s*\{[פס]\}\s*$", "", s)
    s = s.replace("\u00a0", " ")
    s = s.replace("\u2009", " ")
    s = re.sub(r"\s+", " ", s).strip()
    return s


def parse_source_map(block: str) -> dict[str, str]:
    start = block.find("{")
    end = block.rfind("}")
    if start < 0 or end < start:
        die("could not find JSON object in source map section")
    return json.loads(block[start:end + 1])


def parse_source_key(key: str):
    m = SOURCE_RANGE_RE.match(key.strip())
    if not m:
        return None

    book = m.group("book")
    c1 = int(m.group("c1"))
    v1 = int(m.group("v1") or 1)

    c2 = int(m.group("c2") or c1)
    v2 = int(m.group("v2") or m.group("v1") or 999)

    return book, c1, v1, c2, v2


def source_for(book: str, chapter: int, verse: int, source_map: dict[str, str]) -> str:
    want_book = normalize_book(book)

    for key, src in source_map.items():
        parsed = parse_source_key(key)
        if not parsed:
            continue

        b, c1, v1, c2, v2 = parsed
        if normalize_book(b) != want_book:
            continue

        here = (chapter, verse)
        lo = (c1, v1)
        hi = (c2, v2)

        if lo <= here <= hi:
            return normalize_source(src)

    return "Other"


def normalize_book(book: str) -> str:
    aliases = {
        "genesis": "gen",
        "gen": "gen",
        "exodus": "exod",
        "exod": "exod",
        "leviticus": "lev",
        "lev": "lev",
        "numbers": "num",
        "num": "num",
        "deuteronomy": "deut",
        "deut": "deut",
    }
    return aliases.get(book.lower().replace(" ", ""), book.lower().replace(" ", ""))


def normalize_source(src: str) -> str:
    # Prefer first concrete source in comma lists.
    # R,BR,R -> R; P,R -> P; RJE,E -> RJE.
    first = src.split(",")[0].strip()
    return SOURCE_MACRO.get(first, first)


def tex_escape(s: str) -> str:
    repl = {
        "\\": r"\textbackslash{}",
        "&": r"\&",
        "%": r"\%",
        "$": r"\$",
        "#": r"\#",
        "_": r"\_",
        "{": r"\{",
        "}": r"\}",
        "~": r"\textasciitilde{}",
        "^": r"\textasciicircum{}",
    }
    return "".join(repl.get(ch, ch) for ch in s)


def wrap_english(s: str, width: int = 58) -> list[str]:
    if not s:
        return []
    return textwrap.wrap(
        tex_escape(s),
        width=width,
        break_long_words=False,
        break_on_hyphens=False,
    )


def macro_block(kind: str, source: str, text: str, english: bool = False) -> str:
    prefix = "e" if english else "h"
    macro = f"{prefix}{source}"

    if english:
        lines = wrap_english(text)
        if len(lines) <= 1:
            body = lines[0] if lines else ""
            return f"\t\\{macro}{{{body}}}"

        joined = "\\\\\n\t\t".join(lines) + r"\\"
        return f"\t\\{macro}{{\n\t\t{joined}\n\t}}"

    return f"\t\\{macro}{{{text}}}"


def emit_tex(book: str, chapter: int, heb: dict[int, str], eng: dict[int, tuple[str, str]], smap: dict[str, str]) -> str:
    width = 24
    header = "\n".join([
        "%" * width,
        f"%%% {normalize_book(book)} {chapter} %%%",
        "%" * width,
        "",
        f"\\Chapter{{{chapter}}}",
        "",
    ])

    chunks = [header]

    for verse in sorted(heb):
        source = source_for(book, chapter, verse, smap)
        main, foot = eng.get(verse, ("", ""))

        chunks.append(f"\\Verse{{{verse}}}")
        chunks.append("{")
        chunks.append(macro_block("h", source, heb[verse], english=False))
        chunks.append("}")
        chunks.append("{")
        chunks.append(macro_block("e", source, main, english=True))
        chunks.append("}")
        chunks.append("{")
        if foot:
            chunks.append("\t\\footnote{")
            for line in wrap_english(foot, width=72):
                chunks.append(f"\t\t{line}")
            chunks.append("\t}")
        chunks.append("}")
        chunks.append("")

    return "\n".join(chunks).rstrip() + "\n"


def main() -> None:
    ap = argparse.ArgumentParser(
        description="Generate a LuaLaTeX chapter file from a book-prompt generated prompt."
    )
    ap.add_argument("prompt", nargs="?", help="prompt file; stdin is used if omitted")
    ap.add_argument("-o", "--output", help="write output to file instead of stdout")
    args = ap.parse_args()

    if args.prompt:
        prompt = Path(args.prompt).read_text(encoding="utf-8")
    else:
        prompt = sys.stdin.read()

    heb_block = section_after(prompt, "Hebrew Text")
    eng_block = section_after(prompt, "English Text")
    map_block = section_after(prompt, "Source map")

    book, chapter, heb = parse_hebrew(heb_block)
    eng = parse_english(eng_block)
    smap = parse_source_map(map_block)

    tex = emit_tex(book, chapter, heb, eng, smap)

    if args.output:
        Path(args.output).write_text(tex, encoding="utf-8")
    else:
        sys.stdout.write(tex)


if __name__ == "__main__":
    main()
