#!/usr/bin/env bash

# Probably the first bash script I ever wrote.
# At that point, it was just two commands in a file.

determine_xinput_type() {

    # arch, as of 2018-07-01
    LIBINPUT="$(xinput | grep -Po '(?<=id=)\d+' | while read id; do
        xinput --list-props "$id"
    done | grep -ci 'libinput')"

    # gentoo, as of 2018-07-01
    DEVICEACCEL="$(xinput | grep -Po '(?<=id=)\d+' | while read id; do
        xinput --list-props "$id"
    done | grep -ci 'device accel constant deceleration')"

    [[ $DEVICEACCEL -gt 0 ]] && [[ $LIBINPUT -gt 0 ]] && {
        echo "Detected both 'device accel' and 'libinput' versions of xinput."
        echo "Dying out of cautious confusion."
        exit 1
    }

    if [[ $LIBINPUT -gt 0 ]]; then

        xinput_type='libinput Accel Speed'
        HAVE_LIBINPUT=1

    elif [[ $DEVICEACCEL -gt 0 ]]; then

        xinput_type='Device Accel Constant Deceleration'
        HAVE_LIBINPUT=

    fi

}

resolution_size() {
    getresolution | awk -Fx '{ print $1, $2 }'
}

scale_speed_for_resolution() {
    local width="$1"
    local height="$2"
    local lores_speed="$3"
    local hires_speed="$4"

    awk \
        -v width="$width" \
        -v height="$height" \
        -v lores_width=1280 \
        -v lores_height=720 \
        -v hires_width=2560 \
        -v hires_height=1440 \
        -v lores_speed="$lores_speed" \
        -v hires_speed="$hires_speed" '
            BEGIN {
                if (width <= 0 || height <= 0) {
                    print hires_speed
                    exit
                }

                resolution = sqrt(width * width + height * height)
                lores = sqrt(lores_width * lores_width + lores_height * lores_height)
                hires = sqrt(hires_width * hires_width + hires_height * hires_height)
                resolution_scale = (resolution - lores) / (hires - lores)
                print lores_speed + (hires_speed - lores_speed) * resolution_scale
            }
        '
}

xinput_type=
HAVE_LIBINPUT=
determine_xinput_type

if [[ -z "$1" ]]; then

    # set defaults for different machines

    read -r resolution_width resolution_height < <(resolution_size)

    if   [[ $(hostname) == 'Shannon' ]]; then

        if [[ -n $HAVE_LIBINPUT ]]; then
            echo "On Shannon with libinput"
            DEFAULT_HIRES="-0.75"
            DEFAULT_LORES="-0.75"
        else
            echo "On Shannon without libinput"
            DEFAULT_HIRES="1.00"
            DEFAULT_LORES="0.00"
            #DEFAULT_HIRES="-0.75"
            #DEFAULT_LORES="-0.75"
        fi

    elif [[ $(hostname) == 'Turing' || $(hostname) == 'turing' ]]; then

        if [[ -n $HAVE_LIBINPUT ]]; then
            echo "On Turing with libinput"
            DEFAULT_HIRES="-0.75"
            DEFAULT_LORES="-0.75"
        else
            echo "On Turing without libinput"
            #DEFAULT_HIRES="1.00"
            #DEFAULT_LORES="0.00"
            echo "speed: $speed"
            DEFAULT_HIRES="-0.65"
            DEFAULT_LORES="-0.75"
        fi

    else
        if [[ -n $HAVE_LIBINPUT ]]; then
            echo "On Unknown machine with libinput"
            DEFAULT_HIRES="-0.75"
            DEFAULT_LORES="-0.75"
        else
            echo "On Unknown machine without libinput"
            DEFAULT_HIRES="1.20"
            DEFAULT_LORES="1.20"
        fi
    fi

    speed="$(scale_speed_for_resolution "$resolution_width" "$resolution_height" "$DEFAULT_LORES" "$DEFAULT_HIRES")"

else

    speed="$1"

fi

logitech_mouse="Logitech USB Receiver"
insignia_kbd="MOSART Semi. 2.4G RF Keyboard & Mouse   	"
xinput | grep -Pi "(${logitech_mouse}|${insignia_kbd})" | grep -Po '(?<=id=)\d+' | while read device; do
    echo xinput --set-prop "${device}" "${xinput_type}" "${speed}"
    xinput --set-prop "${device}" "${xinput_type}" "${speed}"
done

# Set mouse acceleration
xset m 1/1 0

exit 0


# if [[ -n "$1" ]]; then speed="$1"; else speed="2.0"; fi
# xinput --set-prop 9 "Device Accel Constant Deceleration" "${speed}"
# xset m 1/1 0

