# xinput | grep -i 'Logitech USB Receiver' | grep -Po '(?<=id=)\d+' | while read device; do
#     xinput --set-prop "${device}" "Device Accel Constant Deceleration" "${speed}"
# done
# xset m 1/1 0

#DEFAULT_HIRES="1.5"
# Trying this out b/c the new Arch version of xinput has different property names,
# and so we're gonna have to change our parameter values eventually anyways.
# Arch feels faster, and it isn't so bad. May as well adapt my brain now.

if [[ -n "$1" ]]; then
    # If they specify a speed, set speed to that.
    speed="$1"
else
    # If they don't specify a speed, decide on a default using the resolution.
    if [[ $(hostname) -eq 'Shannon' ]]; then
        if   [[ $(getresolution) == '2560x1440' ]]; then
            speed="$DEFAULT_HIRES"
        elif [[ $(getresolution) == '1280x720' ]]; then
            speed="$DEFAULT_LORES"
        else
            speed="$DEFAULT_HIRES"
            xcowsay "mouse: Unfamiliar resolution on Shannon."
        fi
    elif [[ $(hostname) -eq 'Turing' ]]; then
        if   [[ $(getresolution) == '1600x900' ]]; then
            speed="$DEFAULT_HIRES"
        else
            echo "mouse: Unfamiliar resolution on Turing. Dying."
            exit 1
        fi
    fi

fi

# Set mouse velocity (weirdly called acceleration & deceleration)
xinput | grep -i 'Logitech USB Receiver' | grep -Po '(?<=id=)\d+' | while read device; do
    xinput --set-prop "${device}" "Device Accel Constant Deceleration" "${speed}"
done
# Set mouse acceleration
xset m 1/1 0


exit 0

# This version seems not to work anymore

if [[ -n "$1" ]]; then
    speed="$1"
else
    if   [[ $(hostname) == 'Shannon' ]]; then
        speed="-0.85"
    elif [[ $(hostname) == 'Turing' ]]; then
        speed="-0.50"
    else
        speed="-0.65"
    fi
fi

# New version: Wtf is this new xinput shit?

property="libinput Accel Speed"

# Get the relevant ids
xinput | grep -P 'Logitech USB Receiver.*pointer' | grep -Po '(?<=id=)\d+' | while read id; do
    xinput --set-prop "$id" "$property" "$speed" && 
    echo "Setting \"$property\" to $speed"
done

xset m 1/1 0

