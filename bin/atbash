#!/usr/bin/env python

import sys, argparse

def atbash_map(s):
    return {a:b for a,b in zip(s, s[::-1])}

HEBREW = "אבגדהוזחטיכלמנסעפצקרשת"
HEB_FINALS = {"ך":"כ","ם":"מ","ן":"נ","ף":"פ","ץ":"צ"}

ARAMAIC = "ܐܒܓܕܗܘܙܚܛܝܟܠܡܢܣܥܦܨܩܪܫܬ"

GREEK_U = "ΑΒΓΔΕΖΗΘΙΚΛΜΝΞΟΠΡΣΤΥΦΧΨΩ"
GREEK_L = "αβγδεζηθικλμνξοπρστυφχψω"
GREEK_FINAL = {"ς":"σ"}

GREEK_EXT_U = "ΑΒΓΔΕΖΗΘΙΚΛΜΝΞΟΠϺϘΤΡΣΥΦΧΨΩ"
GREEK_EXT_L = "αβγδεζηθικλμνξοπϻϙτρσυφχψω"

LATIN_U = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
LATIN_L = "abcdefghijklmnopqrstuvwxyz"

def make_map(name):
    if name == "hebrew":
        m = atbash_map(HEBREW)
        for fin, base in HEB_FINALS.items(): m[fin] = m[base]
    elif name == "aramaic":
        m = atbash_map(ARAMAIC)
    elif name == "greek":
        m = atbash_map(GREEK_U); m.update(atbash_map(GREEK_L))
        for fin, base in GREEK_FINAL.items(): m[fin] = m[base]
    elif name == "greek_ext":
        m = atbash_map(GREEK_EXT_U); m.update(atbash_map(GREEK_EXT_L)); m["ς"]=m["σ"]
    elif name == "latin":
        m = atbash_map(LATIN_U); m.update(atbash_map(LATIN_L))
    else:
        sys.exit("unknown alphabet")
    return m

def encode(text, alphabet):
    m = make_map(alphabet)
    return "".join(m.get(ch, ch) for ch in text)

def main():
    ep = (
        "Examples:\n"
        "  atbash -G 'ΑΒΓΔΕϜ...Ω Ϙ Ϻ'\n"
        "  atbash -g 'Αλφα Ωμεγα ς'\n"
        "  atbash -H 'ששך'\n"
        "  atbash -a 'ܒܝܬ'\n"
        "  atbash -l 'Hello, World!'"
    )
    p = argparse.ArgumentParser(
        description="Atbash encoder (default: extended Greek).",
        epilog=ep,
        formatter_class=argparse.RawTextHelpFormatter,
        add_help=True
    )
    grp = p.add_mutually_exclusive_group()
    grp.add_argument("-G","--Greek", action="store_const", const="greek_ext", dest="alphabet",
                     help="Extended Greek (Ϝ/ϝ, Ϙ/ϙ, Ϻ/ϻ). [default]")
    grp.add_argument("-g","--greek", action="store_const", const="greek", dest="alphabet",
                     help="Standard Greek.")
    grp.add_argument("-H","--hebrew", action="store_const", const="hebrew", dest="alphabet",
                     help="Hebrew (finals treated like base letters).")
    grp.add_argument("-a","--aramaic", action="store_const", const="aramaic", dest="alphabet",
                     help="Aramaic (Syriac script).")
    grp.add_argument("-l","--latin", action="store_const", const="latin", dest="alphabet",
                     help="Latin alphabet (English).")
    p.add_argument("text", help="Text to encode.")

    args = p.parse_args()
    alphabet = args.alphabet or "greek_ext"
    print(encode(args.text, alphabet))

if __name__ == "__main__":
    main()

