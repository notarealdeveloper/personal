#!/usr/bin/env python3

import sys


def atbash_map(alphabet):
    """Return a bidirectional Atbash substitution map for one alphabet."""
    return dict(zip(alphabet, reversed(alphabet)))


# ---------------------------------------------------------------------------
# Alphabets
# ---------------------------------------------------------------------------

# Ancient Hebrew order reflected in Lamentations:
#
#   ... נ ס פ ע צ ...
#
# rather than the later-standard:
#
#   ... נ ס ע פ צ ...
#
HEBREW = "אבגדהוזחטיכלמנספעצקרשת"

HEBREW_FINALS = {
    "ך": "כ",
    "ם": "מ",
    "ן": "נ",
    "ף": "פ",
    "ץ": "צ",
}


# Syriac / Aramaic
ARAMAIC = "ܐܒܓܕܗܘܙܚܛܝܟܠܡܢܣܥܦܨܩܪܫܬ"


# Historical Greek order requested:
#
#   ... Ο Π Ϻ Ϙ Ρ Σ ...
#
# San and Qoppa retain their historical positions.
GREEK_UPPER = "ΑΒΓΔΕΖΗΘΙΚΛΜΝΞΟΠϺϘΡΣΤΥΦΧΨΩ"
GREEK_LOWER = "αβγδεζηθικλμνξοπϻϙρστυφχψω"

GREEK_SPECIALS = {
    "ς": "σ",
}


LATIN_UPPER = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
LATIN_LOWER = "abcdefghijklmnopqrstuvwxyz"


# ---------------------------------------------------------------------------
# Build one global substitution map
# ---------------------------------------------------------------------------

ATBASH = {}

for alphabet in (
    HEBREW,
    ARAMAIC,
    GREEK_UPPER,
    GREEK_LOWER,
    LATIN_UPPER,
    LATIN_LOWER,
):
    ATBASH.update(atbash_map(alphabet))


# Hebrew final forms behave as their base forms.
for final, base in HEBREW_FINALS.items():
    ATBASH[final] = ATBASH[base]


# Final sigma behaves as ordinary lowercase sigma.
for special, base in GREEK_SPECIALS.items():
    ATBASH[special] = ATBASH[base]


def encode(text):
    """Atbash all recognized characters; preserve everything else."""
    return "".join(ATBASH.get(ch, ch) for ch in text)


def main():
    # argv input:
    #
    #   atbash אבג
    #
    # Multiple argv words are joined with spaces:
    #
    #   atbash hello world
    #
    # stdin input:
    #
    #   echo אבג | atbash
    #
    if len(sys.argv) > 1:
        text = " ".join(sys.argv[1:])
        sys.stdout.write(encode(text))
        sys.stdout.write("\n")
    else:
        sys.stdout.write(encode(sys.stdin.read()))


if __name__ == "__main__":
    main()
