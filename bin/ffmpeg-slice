#!/usr/bin/env python

"""
ffmpeg-cat -i file.mp4 -w 0:04-0:07,3:21-3:27,9:43-9:49
ffmpeg-cat -i file.mp4 -w 0:04-0:07,3:21-3:27,9:43-9:49 -o out.mkv
"""

import os
import sys
import shutil
import argparse
import tempfile
parser = argparse.ArgumentParser()
parser.add_argument('-i', '--infile')
parser.add_argument('-w', '--windows')
parser.add_argument('-o', '--outfile', default=None)
args = parser.parse_args(sys.argv[1:])

if not args.infile:
    print(f"usage: ffmpeg-cat -i <infile> 0:10-0:20,1:23-1:42 ...")
    sys.exit(0)

if not args.outfile:
    pre, ext = os.path.splitext(args.infile)
    args.outfile = f"{pre}-ffmpeg-cat-{args.windows}{ext}"

infile = os.path.abspath(args.infile)
windows = [window.split('-') for window in args.windows.split(',')]
outfile = os.path.abspath(args.outfile)

tmpdir = tempfile.mkdtemp()
os.chdir(tmpdir)
files = []

for n, (start, end) in enumerate(windows, start=1):
    file = f"{n}.mkv"
    os.system(f"""ffmpeg -i {infile} -ss {start} -to {end} {file}""")
    files.append(file)

file_list = '\n'.join([f"file '{file}'" for file in files])
with open('file-list.txt', 'w') as fp:
    fp.write(file_list)

os.system(f"""ffmpeg -f concat -i file-list.txt -c copy output.mkv;""")

shutil.move("output.mkv", outfile)
shutil.rmtree(tmpdir)
