#!/usr/bin/env bash

source log.sh

if [[ -z "$1" ]]; then
    prefix="$(basename "$PWD")"
    #echo "usage: $(basename $0) <prefix-for-new-filenames>"
    #exit 1
else
    prefix="$1"
fi

if [[ -z "$2" ]]; then
    digits=2
else
    digits="$2"
fi

fmt="%0${digits}d"

echo fixnames -i *

n=1 && for f in $(ls | sort | grep -E '[.](jpg|png)$'); do
    ext="${f##*.}" && echo mv -v "$f" "$(printf "${prefix}-${fmt}.${ext}" "$n")"
    ((n++))
done

printf "${red}*** ${blu}HEY! ${whi}Should I execute the above commands (${gre}y${whi}/${red}n${whi})?: "

read answer

if [[ "$answer" == 'y' || "$answer" == 'Y' ]]; then
    log "Renaming files."
    fixnames -i *.jpg *.png
    n=1 && for f in $(ls | sort | grep -Pi '[.](jpe?g|png|webp|avif|tiff|gif|bmp)$'); do
        ext="${f##*.}" && mv -v "$f" "$(printf "${prefix}-${fmt}.${ext}" "$n")"; ((n++));
    done
else
    log "Not doing anything."
    exit 1
fi
